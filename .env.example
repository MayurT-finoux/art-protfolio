# Copy to .env.local and fill in. Never commit .env.local.

# Neon, project "portfolio", branch production
# Pooled connection string (host contains "-pooler"), used by the app.
DATABASE_URL=
# Direct connection string, used by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=

# Cloudflare R2 (media uploads). Token: Object Read & Write, this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL, e.g. https://pub-xxxx.r2.dev (later: https://media.yurix.art)
R2_PUBLIC_URL=

# Admin sign-in (Better Auth): a long random string (e.g. `openssl rand -base64 48`)
BETTER_AUTH_SECRET=
# Optional: public site URL; inferred from the request when empty
BETTER_AUTH_URL=

# Email (Resend). Without RESEND_API_KEY, emails are printed to the server log.
RESEND_API_KEY=
# Sender; "Yurix <onboarding@resend.dev>" by default (only delivers to your Resend account email)
EMAIL_FROM=
# Where contact notifications go
NOTIFY_EMAIL=
