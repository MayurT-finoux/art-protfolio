# Copy to .env.local and fill in. Never commit .env.local.

# Neon, project "portfolio", branch production
# Pooled connection string (host contains "-pooler"), used by the app.
DATABASE_URL=
# Direct connection string, used by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=

# Cloudflare R2 (media uploads). Token: Object Read & Write, this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL, e.g. https://pub-xxxx.r2.dev (later: https://media.yurix.art)
R2_PUBLIC_URL=
